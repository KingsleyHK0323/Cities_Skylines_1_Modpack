---
interface Props {
	locale?: 'en' | 'zh-tw';
}
const { locale = 'en' } = Astro.props;
const translated = locale === 'zh-tw';
const base = import.meta.env.BASE_URL;
---

<!-- Author: OpenAI-Codex_Responsible: Modpack_Website. -->
<aside class="development-notice" aria-label={translated ? '開發版下載公告' : 'Development build announcement'}>
	<div class="page-wrap notice-layout">
		<div class="notice-copy">
			<p lang="en">Steam Workshop Development editions have been removed. Back up saves, use a separate test city, and enable only one edition of each mod.</p>
			<details>
				<summary lang="en">Historical module-release guidance - not a current download</summary>
			<p class="notice-title">{translated ? '開發版下載：請先確認供應情況' : 'Development downloads: check availability.'} <time datetime="2026-11-02">{translated ? '2026 年 11 月 2 日' : '2 November 2026'}</time></p>
			<p>{translated ? 'Steam 工作坊開發版已下架；GitHub 可安裝附件的現況尚未核實。請查看發布頁及安裝指南，備份存檔、使用測試城市，並僅啟用每個模組的一個版本。' : 'Steam Workshop Development editions have been removed; current GitHub installable attachments have not been verified. Check the release page and installation guide, back up saves, use a test city, and enable only one copy of each mod.'}</p>
			</details>
			{false && (
			<p lang="en"><strong>3 November 2026:</strong> GitHub Releases is planned for the Dev Manager Windows installer; mods are planned for separate artifact branches. The installer is not built or published, and the first two branch candidates remain local. Earlier mod-release download guidance is historical.</p>
			)}
			<p lang="en"><strong>Distribution:</strong> If Dev Manager's Windows Setup.exe has been published, check <a href="https://github.com/KingsleyHK0323/Cities_Skylines_1_Modpack/releases">GitHub Releases</a>. The planned app is intended to show verified module builds when available; availability varies by module. Earlier module-release guidance is historical.</p>
			<!-- Notice wording: OpenAI-Codex_distribution_components. -->
		</div>
		<details>
			<summary lang="en">Historical download label - not a current download</summary>
		<a class="button secondary" href={base + (translated ? 'zh-tw/' : '') + 'wiki/development-downloads/'}>{translated ? '開發版下載與安裝' : 'Development downloads and installation'}</a>
		</details>
		<a class="button secondary" lang="en" href={base + (translated ? 'zh-tw/' : '') + 'wiki/development-downloads/'}>Read distribution guidance</a>
		<!-- Guidance link: OpenAI-Codex_distribution_components. -->
	</div>
</aside>

<style>
	.development-notice { padding: 16px var(--margin); background: var(--surface); border-block: 1px solid var(--field); }
	.notice-layout { display: flex; align-items: center; justify-content: space-between; gap: 16px 28px; }
	.notice-copy { min-width: 0; }
	.notice-copy p { max-width: 85ch; font-size: 14px; line-height: 1.5; }
	.notice-copy .notice-title { margin-bottom: 4px; font-size: 18px; font-weight: 700; }
	time { display: inline-block; margin-inline-start: 8px; color: var(--muted); font-size: 12px; font-weight: 400; }
	.button { flex-shrink: 0; max-width: 100%; text-align: center; font-size: 14px; }
	@media (max-width: 960px) {
		.notice-layout { align-items: flex-start; flex-direction: column; gap: 12px; }
	}
</style>

