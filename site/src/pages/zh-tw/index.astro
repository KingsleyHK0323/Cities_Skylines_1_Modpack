---
import { Image } from 'astro:assets';
import ProjectStatusSummary from '../../components/ProjectStatusSummary.astro';
import PlannedVehicleManagement from '../../components/PlannedVehicleManagement.astro';
import DevelopmentNotice from '../../components/DevelopmentNotice.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { changeEntries } from '../../lib/changelog';
import { getLocalizedChangeEntries } from '../../data/changelog-zh-tw';
import { harmonyUrl } from '../../data/workshop';
import cityArt from '../../assets/brand/modpack-city.png';
import aiImproveArt from '../../assets/projects/ai-improve.png';
import transportArt from '../../assets/projects/transport.png';
import aiGamingArt from '../../assets/projects/ai-gaming.png';
const base = import.meta.env.BASE_URL;
const recent = getLocalizedChangeEntries(changeEntries).slice(0, 5);
const projects = [
	{ art: aiImproveArt, name: 'AI Improve', status: '已在 Workshop 發布', text: '讓城市裡的車輛、公共服務與市民，依照當下真實狀況做決定：塞車、擁擠的月台、附近的火警、滿載的車輛。', page: 'zh-tw/ai-improve/', wiki: 'zh-tw/wiki/ai-improve/overview/' },
	{ art: transportArt, name: 'Automated Public Transport Planning', status: '開發原型 · 遊戲驗收待完成', text: '開發原型可預覽公車路線提案，並在確認後嘗試建立路線。此操作可能變更存檔；測試前請先備份。', page: 'zh-tw/automated-public-transport-planning/', wiki: 'zh-tw/wiki/transport/overview/' },
	{ art: aiGamingArt, name: 'AI Gaming', status: '開發暫停 · 遊戲內執行尚未驗證', text: 'GitHub 開發版本包含配對的 Windows x64 輔助程式，讓玩家逐次確認後取得 Ollama Local 建議。遊戲內執行尚未驗證。', page: 'zh-tw/ai-gaming/', wiki: 'zh-tw/wiki/ai-gaming/overview/' },
];
---

<SiteLayout title="Cities: Skylines 1 Modpack" description="包含 15 個模組的 Cities: Skylines 1 專案，涵蓋原型、設計及暫停中的工作。請參閱附日期的實作與驗收狀態。" locale="zh-tw" active="home">
	<DevelopmentNotice locale="zh-tw" />
	<section class="hero page-wrap">
		<div class="hero-copy">
			<p class="eyebrow">Kingsley 製作的 Cities: Skylines 1 模組</p>
			<h1>讓城市運作得更好。</h1>
			<p class="hero-lead">涵蓋城市行為、交通與公用設施的 15 個模組，各項實作與驗收進度不同。AI Gaming 開發目前暫停。</p>
			<div class="hero-actions"><a class="button" href={base + 'zh-tw/wiki/getting-started/'}>開始使用</a><a class="button secondary" href={base + 'zh-tw/ai-improve/'}>認識 AI Improve</a></div>
		</div>
		<figure class="hero-art"><Image src={cityArt} alt="被紅色交通路線貫穿的城市街區插畫" widths={[520, 760]} sizes="(max-width: 640px) 100vw, 45vw" format="webp" quality={78} loading="eager" /><figcaption class="art-note">插畫 · 並非遊戲截圖</figcaption></figure>
	</section>

	<ProjectStatusSummary locale="zh-tw" />

	<section class="section soft">
		<div class="page-wrap">
			<div class="section-heading"><div><p class="eyebrow">精選專案頁面</p><h2>探索三個現有預覽。</h2></div><p>獨立運作與相容性屬於設計目標。模組組合使用及工作坊訂閱版本的遊戲驗收尚未完成。</p></div>
			<div class="project-grid">
				{projects.map((p) => <article class="project-card"><Image src={p.art} alt={p.name + ' 美術圖'} widths={[420, 640]} sizes="(max-width: 640px) 100vw, 33vw" format="webp" quality={76} /><div class="project-card-copy"><h3>{p.name}</h3><span class="status">{p.status}</span><p>{p.text}</p><div class="card-links"><a href={base + p.page}>專案頁 →</a><a href={base + p.wiki}>使用說明 →</a></div></div></article>)}
			</div>
		</div>
	</section>

	<PlannedVehicleManagement locale="zh-tw" />

	<section class="section">
		<div class="page-wrap columns">
			<div class="text-stack"><p class="eyebrow">開始使用</p><h2>三個步驟就能開始。</h2><p>每個模組頁都有 Workshop 連結，Wiki 會詳細說明每一項設定。</p><div class="hero-actions"><a class="button" href={base + 'zh-tw/wiki/getting-started/'}>閱讀完整指南</a></div></div>
			<ol class="steps">
				<li><strong>訂閱 Harmony</strong><p>AI Improve 需要 <a href={harmonyUrl}>Harmony</a>，這是許多 Cities: Skylines 模組共用的函式庫。</p></li>
				<li><strong>選擇版本</strong><p>穩定版本使用 Steam 工作坊；開發版本已從工作坊下架，GitHub 開發版本仍屬實驗性質。每個模組只可啟用一個版本。</p></li>
				<li><strong>啟用並調整</strong><p>在 Content Manager 啟用模組，再打開模組選項，個別開關需要的功能。</p></li>
			</ol>
		</div>
	</section>

	<section class="section soft">
		<div class="page-wrap">
			<div class="section-heading"><div><p class="eyebrow">最新更新</p><h2>最近的變動。</h2></div><a href={base + 'zh-tw/change-log/'}>完整更新紀錄 →</a></div>
			<ul class="update-list">{recent.map((entry) => <li><time>{entry.date}</time><span>{entry.title}</span></li>)}</ul>
		</div>
	</section>
</SiteLayout>
