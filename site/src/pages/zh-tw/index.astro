---
import { Image } from 'astro:assets';
import ProjectStatusSummary from '../../components/ProjectStatusSummary.astro';
import DevelopmentNotice from '../../components/DevelopmentNotice.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { changeEntries } from '../../lib/changelog';
import { getLocalizedChangeEntries } from '../../data/changelog-zh-tw';
import cityArt from '../../assets/brand/modpack-city.png';
const base = import.meta.env.BASE_URL;
const recent = getLocalizedChangeEntries(changeEntries).slice(0, 3);
---

<SiteLayout title="Cities: Skylines 1 Modpack" description="包含 15 個模組的 Cities: Skylines 1 專案，涵蓋原型、設計及暫停中的工作。請參閱附日期的實作與驗收狀態。" locale="zh-tw" active="home">
	<section class="hero page-wrap">
		<div class="hero-copy">
			<p class="eyebrow">Kingsley 製作的 Cities: Skylines 1 模組</p>
			<h1>讓城市運作得更好。</h1>
			<p class="hero-lead">Cities: Skylines 1 模組專案，探索城市行為、交通與公用設施。各模組處於不同的設計、開發與驗收階段。</p>
			<div class="hero-actions"><a class="button" href={base + 'zh-tw/wiki/project/status/'}>瀏覽模組與進度</a><a class="button secondary" href={base + 'zh-tw/wiki/getting-started/'}>開始使用</a></div>
		</div>
		<figure class="hero-art"><Image src={cityArt} alt="被紅色交通路線貫穿的城市街區插畫" widths={[520, 760]} sizes="(max-width: 640px) 100vw, 45vw" format="webp" quality={78} loading="eager" /><figcaption class="art-note">插畫 · 並非遊戲截圖</figcaption></figure>
	</section>

	<section class="section soft">
		<div class="page-wrap">
			<p class="eyebrow">專案領域</p>
			<h2>相互連繫的城市系統。</h2>
			<p class="section-intro">這些領域說明專案方向；各模組的開發與驗收進度不同。</p>
			<div class="highlight-grid home-areas">
				<article><h3>城市與市民</h3><p>人口、需求及城市服務。</p></article>
				<article><h3>交通與運輸</h3><p>道路、軌道、公車及外部連接。</p></article>
				<article><h3>基礎建設與資源</h3><p>地圖、公用設施及資源交換。</p></article>
			</div>
		</div>
	</section>

	<ProjectStatusSummary locale="zh-tw" />

	<DevelopmentNotice locale="zh-tw" />

	<section class="section">
		<div class="page-wrap columns">
			<div class="text-stack"><p class="eyebrow">開始使用</p><h2>三個步驟開始使用。</h2><p>查看你想試用的模組狀態與使用說明。</p><div class="hero-actions"><a class="button" href={base + 'zh-tw/wiki/getting-started/'}>閱讀完整指南</a></div></div>
			<ol class="steps">
				<li><strong>查看狀態</strong><p>選擇試用前，先確認各模組的進度及可用版本。</p></li>
				<li><strong>核對需求</strong><p>閱讀所選模組的指南及相依項目；可用版本和安裝方式因模組而異。</p></li>
				<li><strong>備份並依指南操作</strong><p>先備份存檔；測試實驗版本時使用測試城市，並按指示安裝及測試。</p></li>
			</ol>
		</div>
	</section>

	<section class="section soft">
		<div class="page-wrap">
			<div class="section-heading"><div><p class="eyebrow">最新更新</p><h2>最近的變動。</h2></div><a href={base + 'zh-tw/change-log/'}>完整更新紀錄 →</a></div>
			<ul class="update-list">{recent.map((entry) => <li><time>{entry.date}</time><span>{entry.title}</span></li>)}</ul>
		</div>
	</section>
</SiteLayout>
