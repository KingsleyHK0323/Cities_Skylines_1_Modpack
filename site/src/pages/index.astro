---
import { Image } from 'astro:assets';
import ProjectStatusSummary from '../components/ProjectStatusSummary.astro';
import DevelopmentNotice from '../components/DevelopmentNotice.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { changeEntries } from '../lib/changelog';
import cityArt from '../assets/brand/modpack-city.png';
const base = import.meta.env.BASE_URL;
const recent = changeEntries.slice(0, 3);
---

<SiteLayout title="Cities: Skylines 1 Modpack" description="A 15-module Cities: Skylines 1 project with prototypes, designs and paused work. See dated implementation and acceptance status." active="home">
	<section class="hero page-wrap">
		<div class="hero-copy">
			<p class="eyebrow">Cities: Skylines 1 mods by Kingsley</p>
			<h1>Make the city work better.</h1>
			<p class="hero-lead" lang="en">A Cities: Skylines 1 mod project exploring city behavior, transport, and utilities. Each module is at a different stage of design, development, and validation.</p>
			<div class="hero-actions"><a class="button" href={base + 'wiki/project/status/'}>Explore modules and status</a><a class="button secondary" href={base + 'wiki/getting-started/'}>Get started</a></div>
		</div>
		<figure class="hero-art"><Image src={cityArt} alt="Illustrated city block crossed by a red transit line" widths={[520, 760]} sizes="(max-width: 640px) 100vw, 45vw" format="webp" quality={78} loading="eager" /><figcaption class="art-note">Illustration · not a gameplay screenshot</figcaption></figure>
	</section>

	<section class="section soft">
		<div class="page-wrap">
			<p class="eyebrow">Project areas</p>
			<h2>A city of connected systems.</h2>
			<p class="section-intro">These areas describe the project's direction; each module follows its own development and validation path.</p>
			<div class="highlight-grid home-areas">
				<article><h3>City and citizens</h3><p>Population, demand, and city services.</p></article>
				<article><h3>Traffic and transport</h3><p>Roads, railways, buses, and outside connections.</p></article>
				<article><h3>Infrastructure and resources</h3><p>Maps, utilities, and resource exchange.</p></article>
			</div>
		</div>
	</section>

	<ProjectStatusSummary />

	<DevelopmentNotice />

	<section class="section">
		<div class="page-wrap columns">
			<div class="text-stack"><p class="eyebrow">How to begin</p><h2>Three steps to get started.</h2><p>Check the status and instructions for the module you want to try.</p><div class="hero-actions"><a class="button" href={base + 'wiki/getting-started/'}>Read the full guide</a></div></div>
			<ol class="steps">
				<li><strong>Check the status</strong><p>Review each module's stage and available versions before deciding what to try.</p></li>
				<li><strong>Check its requirements</strong><p>Read the chosen module's guide and dependencies; availability and installation vary by module.</p></li>
				<li><strong>Back up and follow the guide</strong><p>Back up your saves, use a test city for experimental builds, and follow the installation and testing instructions.</p></li>
			</ol>
		</div>
	</section>

	<section class="section soft">
		<div class="page-wrap">
			<div class="section-heading"><div><p class="eyebrow">Latest updates</p><h2>What changed recently.</h2></div><a href={base + 'change-log/'}>Full change log →</a></div>
			<ul class="update-list">{recent.map((entry) => <li><time>{entry.date}</time><span>{entry.title}</span></li>)}</ul>
		</div>
	</section>
</SiteLayout>
